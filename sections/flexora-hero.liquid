{{ 'flexora-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'flexora-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign hero_id = 'FlexoraHero-' | append: section.id
  assign slide_count = section.blocks.size
-%}

{% if slide_count > 0 %}
  <flexora-hero
    id="{{ hero_id }}"
    class="fx-hero fx-hero--height-{{ section.settings.section_height }}{% if section.settings.mobile_stack_content %} fx-hero--stack-mobile{% endif %}{% if section.settings.enable_parallax %} fx-hero--parallax{% endif %}"
    data-slide-count="{{ slide_count }}"
    data-autoplay="{{ section.settings.enable_autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    data-pause-on-hover="{{ section.settings.pause_on_hover }}"
    data-section-id="{{ section.id }}"
    aria-roledescription="carousel"
    aria-label="{{ 'flexora.hero.label' | t }}"
    tabindex="0"
  >
    <div class="fx-hero__viewport">
      <div class="fx-hero__slides" data-hero-slides>
        {% for block in section.blocks %}
          {%- liquid
            assign slide_position = block.settings.content_position
            if slide_position == 'inherit'
              assign slide_position = section.settings.desktop_content_position
            endif

            assign slide_text_color = block.settings.text_color
            if slide_text_color == blank or slide_text_color == 'rgba(0,0,0,0)'
              assign slide_text_color = section.settings.text_color
            endif

            assign slide_overlay = section.settings.overlay_opacity
            if block.settings.overlay_opacity >= 0
              assign slide_overlay = block.settings.overlay_opacity
            endif

            assign image_alt = block.settings.image.alt | default: block.settings.heading | default: shop.name
            assign image_loading = 'lazy'
            assign image_priority = 'auto'
            if forloop.first
              assign image_loading = 'eager'
              assign image_priority = 'high'
            endif
          -%}

          <article
            id="{{ hero_id }}-slide-{{ forloop.index }}"
            class="fx-hero__slide{% if forloop.first %} is-active{% endif %}"
            style="
              --fx-hero-text: {{ slide_text_color }};
              --fx-hero-overlay: {{ section.settings.overlay_color | color_modify: 'alpha', slide_overlay | divided_by: 100.0 }};
            "
            data-hero-slide
            data-slide-index="{{ forloop.index0 }}"
            aria-roledescription="{{ 'flexora.hero.slide' | t }}"
            aria-label="{{ 'flexora.hero.go_to_slide' | t: number: forloop.index }}"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="fx-hero__media">
              {% if block.settings.image != blank %}
                <picture>
                  {% if block.settings.mobile_image != blank %}
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ block.settings.mobile_image | image_url: width: 375 }} 375w,
                        {{ block.settings.mobile_image | image_url: width: 550 }} 550w,
                        {{ block.settings.mobile_image | image_url: width: 750 }} 750w
                      "
                      sizes="100vw"
                    >
                  {% endif %}
                  {{
                    block.settings.image
                    | image_url: width: 2400
                    | image_tag:
                      widths: '750, 1100, 1500, 1780, 2000, 2400',
                      sizes: '100vw',
                      loading: image_loading,
                      fetchpriority: image_priority,
                      alt: image_alt,
                      class: 'fx-hero__image'
                  }}
                </picture>
              {% else %}
                <div class="fx-hero__placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>

            <div class="fx-hero__overlay" aria-hidden="true"></div>

            <div class="fx-hero__content-wrap fx-hero__content-wrap--desktop-{{ slide_position }} fx-hero__content-wrap--mobile-{{ section.settings.mobile_content_position }}">
              <div class="fx-hero__content fx-hero__content--{{ section.settings.content_width }} fx-text-{{ section.settings.text_alignment }}">
                {% if block.settings.badge_text != blank %}
                  {% render 'flexora-badge', label: block.settings.badge_text, type: 'neutral', classes: 'fx-hero__badge' %}
                {% endif %}

                {% if block.settings.eyebrow != blank %}
                  <p class="fx-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h2 class="fx-hero__heading">{{ block.settings.heading | escape }}</h2>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="fx-hero__text">{{ block.settings.text }}</div>
                {% endif %}

                {% if block.settings.primary_button_label != blank or block.settings.secondary_button_label != blank %}
                  <div class="fx-hero__actions">
                    {% render 'flexora-button',
                      label: block.settings.primary_button_label,
                      url: block.settings.primary_button_link,
                      style: section.settings.button_style,
                      size: 'large'
                    %}
                    {% render 'flexora-button',
                      label: block.settings.secondary_button_label,
                      url: block.settings.secondary_button_link,
                      style: 'outline',
                      size: 'large'
                    %}
                  </div>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      {% if slide_count > 1 %}
        {% if section.settings.show_arrows %}
          <div class="fx-hero__arrows">
            <button class="fx-hero__arrow fx-hero__arrow--previous" type="button" data-hero-previous aria-label="{{ 'flexora.hero.previous' | t }}">
              <span aria-hidden="true">&larr;</span>
            </button>
            <button class="fx-hero__arrow fx-hero__arrow--next" type="button" data-hero-next aria-label="{{ 'flexora.hero.next' | t }}">
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        {% endif %}

        {% if section.settings.show_dots %}
          <div class="fx-hero__dots" role="group" aria-label="{{ 'flexora.hero.slide' | t }}">
            {% for block in section.blocks %}
              <button
                class="fx-hero__dot{% if forloop.first %} is-active{% endif %}"
                type="button"
                data-hero-dot="{{ forloop.index0 }}"
                aria-label="{{ 'flexora.hero.go_to_slide' | t: number: forloop.index }}"
                aria-controls="{{ hero_id }}-slide-{{ forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              ></button>
            {% endfor %}
          </div>
        {% endif %}
      {% endif %}

      {% if section.settings.show_scroll_indicator %}
        <a class="fx-hero__scroll" href="#MainContent" aria-label="{{ 'flexora.hero.scroll_down' | t }}">
          <span aria-hidden="true"></span>
        </a>
      {% endif %}
    </div>
  </flexora-hero>
{% elsif request.design_mode %}
  <div class="fx-hero fx-hero--placeholder full-width">
    <div class="fx-hero__placeholder-content">
      <h2>{{ 'flexora.hero.placeholder_heading' | t }}</h2>
      <p>{{ 'flexora.hero.placeholder_text' | t }}</p>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.flexora_hero.name",
  "tag": "section",
  "class": "full-width",
  "settings": [
    {
      "type": "select",
      "id": "section_height",
      "label": "t:sections.flexora_hero.settings.section_height.label",
      "options": [
        { "value": "small", "label": "t:sections.flexora_hero.settings.section_height.options.small" },
        { "value": "medium", "label": "t:sections.flexora_hero.settings.section_height.options.medium" },
        { "value": "large", "label": "t:sections.flexora_hero.settings.section_height.options.large" },
        { "value": "fullscreen", "label": "t:sections.flexora_hero.settings.section_height.options.fullscreen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "t:sections.flexora_hero.settings.desktop_content_position.label",
      "options": [
        { "value": "start", "label": "t:sections.flexora_hero.options.position.start" },
        { "value": "center", "label": "t:sections.flexora_hero.options.position.center" },
        { "value": "end", "label": "t:sections.flexora_hero.options.position.end" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "t:sections.flexora_hero.settings.mobile_content_position.label",
      "options": [
        { "value": "start", "label": "t:sections.flexora_hero.options.position.start" },
        { "value": "center", "label": "t:sections.flexora_hero.options.position.center" },
        { "value": "end", "label": "t:sections.flexora_hero.options.position.end" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:sections.flexora_hero.settings.content_width.label",
      "options": [
        { "value": "narrow", "label": "t:sections.flexora_hero.options.content_width.narrow" },
        { "value": "medium", "label": "t:sections.flexora_hero.options.content_width.medium" },
        { "value": "wide", "label": "t:sections.flexora_hero.options.content_width.wide" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.flexora_hero.settings.text_alignment.label",
      "options": [
        { "value": "start", "label": "t:sections.flexora_hero.options.position.start" },
        { "value": "center", "label": "t:sections.flexora_hero.options.position.center" },
        { "value": "end", "label": "t:sections.flexora_hero.options.position.end" }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.flexora_hero.settings.overlay_opacity.label",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.flexora_hero.settings.text_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.flexora_hero.settings.overlay_color.label",
      "default": "#111827"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.flexora_hero.settings.button_style.label",
      "options": [
        { "value": "primary", "label": "t:flexora.button_primary" },
        { "value": "secondary", "label": "t:flexora.button_secondary" },
        { "value": "outline", "label": "t:flexora.button_outline" }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "t:sections.flexora_hero.settings.enable_autoplay.label",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.flexora_hero.settings.autoplay_speed.label",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:sections.flexora_hero.settings.show_arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "t:sections.flexora_hero.settings.show_dots.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.flexora_hero.settings.pause_on_hover.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "t:sections.flexora_hero.settings.enable_parallax.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_stack_content",
      "label": "t:sections.flexora_hero.settings.mobile_stack_content.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "t:sections.flexora_hero.settings.show_scroll_indicator.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.flexora_hero.blocks.slide.name",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.flexora_hero.blocks.slide.settings.image.label" },
        { "type": "image_picker", "id": "mobile_image", "label": "t:sections.flexora_hero.blocks.slide.settings.mobile_image.label" },
        { "type": "text", "id": "eyebrow", "label": "t:sections.flexora_hero.blocks.slide.settings.eyebrow.label" },
        { "type": "text", "id": "heading", "label": "t:sections.flexora_hero.blocks.slide.settings.heading.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.flexora_hero.blocks.slide.settings.text.label" },
        { "type": "text", "id": "primary_button_label", "label": "t:sections.flexora_hero.blocks.slide.settings.primary_button_label.label" },
        { "type": "url", "id": "primary_button_link", "label": "t:sections.flexora_hero.blocks.slide.settings.primary_button_link.label" },
        { "type": "text", "id": "secondary_button_label", "label": "t:sections.flexora_hero.blocks.slide.settings.secondary_button_label.label" },
        { "type": "url", "id": "secondary_button_link", "label": "t:sections.flexora_hero.blocks.slide.settings.secondary_button_link.label" },
        { "type": "text", "id": "badge_text", "label": "t:sections.flexora_hero.blocks.slide.settings.badge_text.label" },
        {
          "type": "select",
          "id": "content_position",
          "label": "t:sections.flexora_hero.blocks.slide.settings.content_position.label",
          "options": [
            { "value": "inherit", "label": "t:sections.flexora_hero.options.position.inherit" },
            { "value": "start", "label": "t:sections.flexora_hero.options.position.start" },
            { "value": "center", "label": "t:sections.flexora_hero.options.position.center" },
            { "value": "end", "label": "t:sections.flexora_hero.options.position.end" }
          ],
          "default": "inherit"
        },
        { "type": "color", "id": "text_color", "label": "t:sections.flexora_hero.blocks.slide.settings.text_color.label" },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "t:sections.flexora_hero.blocks.slide.settings.overlay_opacity.label",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 35
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.flexora_hero.name",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "تجربة تسوق مرنة",
            "heading": "اكتشف منتجاتك المفضلة بتجربة تسوق عصرية",
            "text": "<p>صمم واجهة متجرك بطريقة مرنة وسريعة تناسب علامتك التجارية.</p>",
            "primary_button_label": "تسوق الآن"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "مصمم لكل متجر",
            "heading": "أسلوب راقٍ يناسب مختلف أنواع المنتجات",
            "text": "<p>اعرض قصتك ومنتجاتك بوضوح على جميع الشاشات.</p>",
            "primary_button_label": "اكتشف المزيد"
          }
        }
      ]
    }
  ]
}
{% endschema %}
