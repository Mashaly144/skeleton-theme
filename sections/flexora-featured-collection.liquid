{{ 'flexora-product-card.css' | asset_url | stylesheet_tag }}
{{ 'flexora-featured-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'flexora-featured-collection.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign featured_collection = section.settings.collection
  assign section_id = 'FlexoraFeaturedCollection-' | append: section.id
  assign heading_id = section_id | append: '-heading'
  assign has_heading = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign has_heading = true
  endif
  assign view_all_label = section.settings.view_all_label
  if view_all_label == blank
    assign view_all_label = 'flexora.featured_collection.view_all' | t
  endif
-%}

{% if featured_collection != blank or request.design_mode %}
  <section
    id="{{ section_id }}"
    class="fx-featured-collection fx-section fx-section--{{ section.settings.section_spacing }}"
    style="
      --fx-featured-background: {{ section.settings.background_color }};
      --fx-featured-text: {{ section.settings.text_color }};
      --fx-products-desktop: {{ section.settings.columns_desktop }};
      --fx-products-tablet: {{ section.settings.columns_tablet }};
      --fx-products-mobile: {{ section.settings.columns_mobile }};
    "
    {% if has_heading %}
      aria-labelledby="{{ heading_id }}"
    {% endif %}
  >
    <div class="fx-container">
      <div class="fx-featured-collection__heading-row">
        {% render 'flexora-section-header',
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          text: section.settings.text,
          align: section.settings.heading_alignment,
          heading_tag: 'h2',
          classes: 'fx-featured-collection__header',
          id: heading_id
        %}

        {% if section.settings.show_view_all and featured_collection != blank %}
          {% render 'flexora-button',
            label: view_all_label,
            url: featured_collection.url,
            style: section.settings.button_style,
            size: 'medium',
            classes: 'fx-featured-collection__view-all'
          %}
        {% endif %}
      </div>

      <flexora-featured-collection
        class="fx-featured-collection__shell"
        data-layout="{{ section.settings.layout }}"
      >
        {% if featured_collection != blank and featured_collection.products_count > 0 %}
          <ul
            class="fx-featured-collection__list fx-featured-collection__list--{{ section.settings.layout }}{% if section.settings.enable_mobile_scroll %} fx-featured-collection__list--mobile-scroll{% endif %}"
            data-featured-track
          >
            {% for product in featured_collection.products limit: section.settings.products_to_show %}
              <li class="fx-featured-collection__item">
                {% render 'flexora-product-card',
                  product: product,
                  card_style: section.settings.card_style,
                  image_ratio: section.settings.image_ratio,
                  show_vendor: section.settings.show_vendor,
                  show_rating: false,
                  show_price: section.settings.show_price,
                  show_badges: section.settings.show_badges,
                  show_quick_add: section.settings.show_quick_add,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_swatches: section.settings.show_swatches,
                  button_style: section.settings.button_style
                %}
              </li>
            {% endfor %}
          </ul>

          {% if section.settings.layout == 'carousel' and section.settings.show_arrows and featured_collection.products_count > 1 %}
            <div class="fx-featured-collection__arrows">
              <button type="button" class="fx-featured-collection__arrow" data-featured-previous aria-label="{{ 'flexora.featured_collection.previous' | t }}">
                <span aria-hidden="true">&larr;</span>
              </button>
              <button type="button" class="fx-featured-collection__arrow" data-featured-next aria-label="{{ 'flexora.featured_collection.next' | t }}">
                <span aria-hidden="true">&rarr;</span>
              </button>
            </div>
          {% endif %}
        {% elsif featured_collection != blank %}
          <p class="fx-featured-collection__empty">{{ 'flexora.featured_collection.empty' | t }}</p>
        {% elsif request.design_mode %}
          <div class="fx-featured-collection__placeholder">
            <h2>{{ 'flexora.featured_collection.placeholder_heading' | t }}</h2>
            <p>{{ 'flexora.featured_collection.placeholder_text' | t }}</p>
          </div>
          <ul class="fx-featured-collection__list" aria-hidden="true">
            {% for index in (1..4) %}
              <li class="fx-featured-collection__item">
                {% render 'flexora-product-card',
                  product: blank,
                  card_style: section.settings.card_style,
                  image_ratio: section.settings.image_ratio,
                  show_placeholder: true
                %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </flexora-featured-collection>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.flexora_featured_collection.name",
  "tag": "div",
  "class": "full-width",
  "settings": [
    { "type": "collection", "id": "collection", "label": "t:sections.flexora_featured_collection.settings.collection.label" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.flexora_featured_collection.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.flexora_featured_collection.settings.heading.label" },
    { "type": "richtext", "id": "text", "label": "t:sections.flexora_featured_collection.settings.text.label" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.flexora_featured_collection.settings.heading_alignment.label",
      "options": [
        { "value": "start", "label": "t:sections.flexora_featured_collection.options.position.start" },
        { "value": "center", "label": "t:sections.flexora_featured_collection.options.position.center" },
        { "value": "end", "label": "t:sections.flexora_featured_collection.options.position.end" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.flexora_featured_collection.settings.layout.label",
      "options": [
        { "value": "grid", "label": "t:sections.flexora_featured_collection.settings.layout.options.grid" },
        { "value": "carousel", "label": "t:sections.flexora_featured_collection.settings.layout.options.carousel" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "products_to_show", "label": "t:sections.flexora_featured_collection.settings.products_to_show.label", "min": 2, "max": 24, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.flexora_featured_collection.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "t:sections.flexora_featured_collection.settings.columns_tablet.label",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.flexora_featured_collection.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.flexora_featured_collection.settings.image_ratio.label",
      "options": [
        { "value": "square", "label": "t:sections.flexora_featured_collection.options.image_ratio.square" },
        { "value": "portrait", "label": "t:sections.flexora_featured_collection.options.image_ratio.portrait" },
        { "value": "landscape", "label": "t:sections.flexora_featured_collection.options.image_ratio.landscape" },
        { "value": "natural", "label": "t:sections.flexora_featured_collection.options.image_ratio.natural" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:sections.flexora_featured_collection.settings.card_style.label",
      "options": [
        { "value": "soft", "label": "t:sections.flexora_featured_collection.options.card_style.soft" },
        { "value": "bordered", "label": "t:sections.flexora_featured_collection.options.card_style.bordered" },
        { "value": "shadow", "label": "t:sections.flexora_featured_collection.options.card_style.shadow" },
        { "value": "minimal", "label": "t:sections.flexora_featured_collection.options.card_style.minimal" }
      ],
      "default": "soft"
    },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.flexora_featured_collection.settings.show_vendor.label", "default": false },
    { "type": "checkbox", "id": "show_price", "label": "t:sections.flexora_featured_collection.settings.show_price.label", "default": true },
    { "type": "checkbox", "id": "show_badges", "label": "t:sections.flexora_featured_collection.settings.show_badges.label", "default": true },
    { "type": "checkbox", "id": "show_secondary_image", "label": "t:sections.flexora_featured_collection.settings.show_secondary_image.label", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "t:sections.flexora_featured_collection.settings.show_quick_add.label", "default": true },
    { "type": "checkbox", "id": "show_swatches", "label": "t:sections.flexora_featured_collection.settings.show_swatches.label", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "t:sections.flexora_featured_collection.settings.show_view_all.label", "default": true },
    { "type": "text", "id": "view_all_label", "label": "t:sections.flexora_featured_collection.settings.view_all_label.label" },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.flexora_featured_collection.settings.button_style.label",
      "options": [
        { "value": "primary", "label": "t:sections.flexora_featured_collection.options.button_style.primary" },
        { "value": "secondary", "label": "t:sections.flexora_featured_collection.options.button_style.secondary" },
        { "value": "outline", "label": "t:sections.flexora_featured_collection.options.button_style.outline" },
        { "value": "ghost", "label": "t:sections.flexora_featured_collection.options.button_style.ghost" }
      ],
      "default": "primary"
    },
    { "type": "checkbox", "id": "enable_mobile_scroll", "label": "t:sections.flexora_featured_collection.settings.enable_mobile_scroll.label", "default": true },
    { "type": "checkbox", "id": "show_arrows", "label": "t:sections.flexora_featured_collection.settings.show_arrows.label", "default": true },
    {
      "type": "select",
      "id": "section_spacing",
      "label": "t:sections.flexora_featured_collection.settings.section_spacing.label",
      "options": [
        { "value": "small", "label": "t:sections.flexora_featured_collection.options.spacing.small" },
        { "value": "medium", "label": "t:sections.flexora_featured_collection.options.spacing.medium" },
        { "value": "large", "label": "t:sections.flexora_featured_collection.options.spacing.large" }
      ],
      "default": "medium"
    },
    { "type": "color", "id": "background_color", "label": "t:sections.flexora_featured_collection.settings.background_color.label", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "t:sections.flexora_featured_collection.settings.text_color.label", "default": "#1F2933" }
  ],
  "presets": [
    {
      "name": "t:sections.flexora_featured_collection.name",
      "settings": {
        "heading": "منتجات مختارة لك",
        "text": "<p>اعرض أفضل منتجاتك بطريقة واضحة وجذابة.</p>"
      }
    }
  ]
}
{% endschema %}
