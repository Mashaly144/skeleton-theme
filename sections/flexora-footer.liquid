{%- liquid
  assign footer_form_id = 'FlexoraNewsletter-' | append: section.id
  assign footer_logo_alt = section.settings.logo.alt | default: shop.name
  assign footer_logo_width = section.settings.logo_width | times: 2
  assign show_newsletter = false

  if settings.fx_newsletter_enabled and section.settings.show_newsletter
    assign show_newsletter = true
  endif
-%}

<footer
  class="fx-site-footer fx-site-footer--{{ section.settings.footer_layout }}{% if section.settings.show_border %} fx-site-footer--bordered{% endif %}"
  style="--fx-footer-background: {{ section.settings.background_color }}; --fx-footer-color: {{ section.settings.text_color }};"
>
  <div class="fx-site-footer__inner">
    <div class="fx-site-footer__content">
      {% if section.settings.logo != blank or section.settings.description != blank %}
        <div class="fx-site-footer__brand">
          {% if section.settings.logo != blank %}
            <a class="fx-site-footer__logo" href="{{ routes.root_url }}">
              {{
                section.settings.logo
                | image_url: width: footer_logo_width
                | image_tag:
                  widths: '120, 180, 240, 320, 400, 480',
                  width: section.settings.logo_width,
                  alt: footer_logo_alt,
                  loading: 'lazy'
              }}
            </a>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="fx-site-footer__description rte">{{ section.settings.description }}</div>
          {% endif %}

          {% if section.settings.show_social %}
            {% render 'flexora-social-links', show_labels: false, icon_style: 'outline', size: 'medium' %}
          {% endif %}
        </div>
      {% elsif section.settings.show_social %}
        <div class="fx-site-footer__brand">
          {% render 'flexora-social-links', show_labels: false, icon_style: 'outline', size: 'medium' %}
        </div>
      {% endif %}

      {% if section.settings.menu != blank %}
        <div class="fx-site-footer__menu">
          <nav class="fx-site-footer__desktop-menu" aria-label="{{ 'flexora.footer.menu' | t }}">
            <h2 class="fx-site-footer__heading">{{ section.settings.menu.title | escape }}</h2>
            <ul class="fx-site-footer__links" role="list">
              {% for link in section.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </nav>

          <details class="fx-site-footer__mobile-menu"{% unless section.settings.mobile_accordion %} open{% endunless %}>
            <summary>{{ section.settings.menu.title | escape }}</summary>
            <ul class="fx-site-footer__links" role="list">
              {% for link in section.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </details>
        </div>
      {% endif %}

      {% if section.settings.secondary_menu != blank %}
        <div class="fx-site-footer__menu">
          <nav class="fx-site-footer__desktop-menu" aria-label="{{ 'flexora.footer.secondary_menu' | t }}">
            <h2 class="fx-site-footer__heading">{{ section.settings.secondary_menu.title | escape }}</h2>
            <ul class="fx-site-footer__links" role="list">
              {% for link in section.settings.secondary_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </nav>

          <details class="fx-site-footer__mobile-menu"{% unless section.settings.mobile_accordion %} open{% endunless %}>
            <summary>{{ section.settings.secondary_menu.title | escape }}</summary>
            <ul class="fx-site-footer__links" role="list">
              {% for link in section.settings.secondary_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            </ul>
          </details>
        </div>
      {% endif %}

      {% if show_newsletter %}
        <div class="fx-site-footer__newsletter">
          {% render 'flexora-newsletter-form',
            heading: settings.fx_newsletter_heading,
            text: settings.fx_newsletter_text,
            button_label: settings.fx_newsletter_button_label,
            form_id: footer_form_id
          %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_language_selector or section.settings.show_country_selector %}
      {% form 'localization', class: 'fx-site-footer__localization' %}
        {% if section.settings.show_language_selector and localization.available_languages.size > 1 %}
          <div class="fx-field">
            <label class="fx-label" for="FooterLanguage-{{ section.id }}">{{ 'flexora.footer.language' | t }}</label>
            <select id="FooterLanguage-{{ section.id }}" class="fx-select" name="locale_code" onchange="this.form.submit()">
              {% for language in localization.available_languages %}
                <option
                  value="{{ language.iso_code }}"
                  lang="{{ language.iso_code }}"
                  {% if language.iso_code == localization.language.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ language.endonym_name | capitalize }}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}

        {% if section.settings.show_country_selector and localization.available_countries.size > 1 %}
          <div class="fx-field">
            <label class="fx-label" for="FooterCountry-{{ section.id }}">{{ 'flexora.footer.country' | t }}</label>
            <select id="FooterCountry-{{ section.id }}" class="fx-select" name="country_code" onchange="this.form.submit()">
              {% for country in localization.available_countries %}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
      {% endform %}
    {% endif %}

    <div class="fx-site-footer__bottom">
      {% if section.settings.show_copyright %}
        <div class="fx-site-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }}
          {% if section.settings.custom_copyright != blank %}
            {{ section.settings.custom_copyright | escape }}
          {% else %}
            <a href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="fx-site-footer__payments" aria-label="{{ 'flexora.footer.payment_methods' | t }}">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.flexora_footer.name",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.flexora_footer.settings.logo.label"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "t:sections.flexora_footer.settings.logo_width.label",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.flexora_footer.settings.description.label"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.flexora_footer.settings.menu.label",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "secondary_menu",
      "label": "t:sections.flexora_footer.settings.secondary_menu.label"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.flexora_footer.settings.show_social.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.flexora_footer.settings.show_newsletter.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.flexora_footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "t:sections.flexora_footer.settings.show_language_selector.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:sections.flexora_footer.settings.show_country_selector.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "t:sections.flexora_footer.settings.show_copyright.label",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_copyright",
      "label": "t:sections.flexora_footer.settings.custom_copyright.label"
    },
    {
      "type": "select",
      "id": "footer_layout",
      "label": "t:sections.flexora_footer.settings.layout.label",
      "options": [
        {
          "value": "simple",
          "label": "t:sections.flexora_footer.options.layout.simple"
        },
        {
          "value": "columns",
          "label": "t:sections.flexora_footer.options.layout.columns"
        },
        {
          "value": "newsletter-first",
          "label": "t:sections.flexora_footer.options.layout.newsletter_first"
        }
      ],
      "default": "columns"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.flexora_footer.settings.background_color.label",
      "default": "#F4F6F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.flexora_footer.settings.text_color.label",
      "default": "#1F2933"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "t:sections.flexora_footer.settings.show_border.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "mobile_accordion",
      "label": "t:sections.flexora_footer.settings.mobile_accordion.label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.flexora_footer.name"
    }
  ]
}
{% endschema %}
