<!doctype html>
{%- liquid
  assign language_code = request.locale.iso_code | default: 'ar'
  assign primary_language = language_code | split: '-' | first | downcase
  assign rtl_languages = 'ar,fa,he,ur' | split: ','
  assign text_direction = 'ltr'

  if rtl_languages contains primary_language
    assign text_direction = 'rtl'
  endif
-%}
<html lang="{{ language_code }}" dir="{{ text_direction }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}
    {% render 'flexora-design-tokens' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'flexora-base.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="fx-theme fx-dir-{{ text_direction }} fx-lang-{{ primary_language }} template-{{ request.page_type | handle }}">
    {% sections 'header-group' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
